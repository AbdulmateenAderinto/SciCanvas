{
  "name": "scicanvas",
  "productName": "SciCanvas",
  "version": "1.0.0",
  "description": "Desktop scientific illustration, graphing and figure-assembly tool",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/packs.js all",
    "setup": "sh scripts/setup-electron.sh",
    "dist": "electron-builder --mac dmg --arm64",
    "dist:intel": "electron-builder --mac dmg --x64",
    "lint": "eslint .",
    "test": "node --test \"test/**/*.test.js\"",
    "mcp": "node scripts/mcp-server.js"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "globals": "^17.13.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "3dmol": "^2.5.5",
    "jszip": "^3.10.2",
    "pako": "^1.0.11",
    "polygon-clipping": "^0.15.7",
    "pptxgenjs": "^4.0.1",
    "smiles-drawer": "^2.4.1",
    "utif": "^3.1.0"
  },
  "author": "SciCanvas",
  "build": {
    "appId": "com.scicanvas.app",
    "productName": "SciCanvas",
    "copyright": "SciCanvas",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!assets/**",
      "!dist/**",
      "!build/**",
      "!.claude/**",
      "!scripts/setup-electron.sh",
      "!README.md",
      "!test/**",
      "!eslint.config.js"
    ],
    "extraResources": [
      {
        "from": "assets/iconpacks",
        "to": "iconpacks"
      }
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "SciCanvas ${version}",
      "artifactName": "SciCanvas-${version}-${arch}.dmg"
    },
    "fileAssociations": [
      {
        "ext": "scifig",
        "name": "SciCanvas Figure",
        "role": "Editor",
        "icon": "build/icon.png"
      },
      {
        "ext": "scitemplate",
        "name": "SciCanvas Template",
        "role": "Editor"
      }
    ]
  }
}
